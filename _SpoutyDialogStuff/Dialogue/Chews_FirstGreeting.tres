dialogs = {
"GREETING_DIALOG_1": {
"default": "Whatever it is, I dont have time to deal with it-
Oh... its you! Out of all people in the Colony, I didnt think you'd be here.
Say, you still have that pistol you came into town touting?",
"en": ""
},
"GREETING_DIALOG_2": {
"default": "Good good, I'm commissioning you for a mission then.
Our raiders are being pinned down by a cluster of automatons that made their way to the reception floor
Clear out a path for the raiders, and I'll get you some ration tokens and chits.
You can keep whatever you find of course.
The doors to the reception are just ahead.",
"en": ""
},
"GREETING_DIALOG_3": {
"default": "Well, we got a problem that can be resolved with shooting, and my K54 is broken.",
"en": ""
},
"GREETING_DIALOG_4": {
"default": "Of course there is, this is hazardous, and given your track record its going to be half way to your record.",
"en": ""
},
"GREETING_OPT1_1": {
"default": "I do."
},
"GREETING_OPT1_2": {
"default": "Whats it matter to you?"
},
"GREETING_OPT2_1": {
"default": "Is there pay?"
},
"GREETING_OPT3_1": {
"default": "I'll take up this job of yours then."
}
}
