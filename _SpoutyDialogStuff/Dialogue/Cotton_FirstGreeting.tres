dialogs = {
"GREETING_DIALOG_1": {
"default": "Well well well, if it isn't the town recluse. Hows... whatever you're doing?",
"en": ""
},
"GREETING_DIALOG_2": {
"default": "You're more talkative then normal... what do you want?",
"en": ""
},
"GREETING_DIALOG_3": {
"default": "Just as talkative as always...
whats got you coming out of your hole?",
"en": ""
},
"GREETING_DIALOG_4": {
"default": "Supply is low, we're prioritizing the children and the vulnerable.
Even if we did, I doubt you got any ration tokens for some.
I heard Chews is in need of help, if you feel like doing something productive for once.",
"en": ""
},
"GREETING_OPT1_1": {
"default": "Doing as well as I can."
},
"GREETING_OPT1_2": {
"default": "Not your business."
},
"GREETING_OPT1_3": {
"default": "Got any water?"
},
"GREETING_OPT2_1": {
"default": "Hoping to get water."
}
}
